# ==========================================
# GERAL E SUPABASE
# ==========================================
# Role de runtime: não pode ser owner, superuser, CREATEDB, CREATEROLE ou BYPASSRLS.
DATABASE_URL=postgresql://app_runtime:senha-runtime@db.example.com:5432/expresso

# Role separada de deploy/migration; nunca é repassada aos serviços de runtime.
DIRECT_URL=postgresql://app_migrator:senha-migrator@db.example.com:5432/expresso

# ==========================================
# BACKEND (DJANGO & CELERY)
# ==========================================
DJANGO_ENV=production
DJANGO_SECRET_KEY=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_SECRET_KEY=gere-outro-segredo-aleatorio-com-pelo-menos-32-caracteres
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seu-dominio.com,localhost
CORS_ALLOWED_ORIGINS=https://seu-dominio.com,http://localhost:5173
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1

# ==========================================
# FRONTEND (VITE/REACT)
# ==========================================
VITE_API_URL=https://api.seu-dominio.com
PORT=5173
NODE_ENV=production

# ==========================================
# INTEGRAÇÕES E IA
# ==========================================
GEMINI_API_KEY=sua-chave-gemini
GOOGLE_MAPS_PLATFORM_KEY=sua-chave-maps
EFI_WEBHOOK_HMAC=gere-um-segredo-exclusivo-para-a-url-do-webhook
EFI_REQUIRE_MTLS_HEADER=True
BIOMETRICS_PROVIDER_URL=https://biometria.seu-provedor.com/verify
BIOMETRICS_API_KEY=chave-do-provedor
BIOMETRICS_WEBHOOK_SECRET=gere-um-segredo-exclusivo-para-o-webhook

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evo.seu-dominio.com
EVOLUTION_API_KEY=sua-global-api-key
EVOLUTION_INSTANCE_NAME=sua-instancia
EVOLUTION_INSTANCE_TOKEN=seu-token-de-instancia
